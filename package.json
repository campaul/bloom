{
  "devDependencies": {
    "elm": "^0.19.1-6",
    "elm-format": "^0.8.8",
    "esbuild": "^0.27.2"
  },
  "scripts": {
    "build": "npm run build-elm && npm run build-js && npm run build-css && npm run build-html && npm run build-assets && npm run minify-js && npm run minify-css",
    "build-assets": "cp -r assets dist",
    "build-css": "esbuild --bundle src/css/bloom.css --outfile=dist/bloom.css",
    "build-elm": "elm make src/elm/Main.elm --optimize --output=dist/bloom.js",
    "build-html": "cp src/html/index.html dist/",
    "build-js": "esbuild src/js/lib.js --minify --outfile=dist/lib.min.js",
    "minify-js": "esbuild dist/bloom.js --minify --outfile=dist/bloom.min.js",
    "minify-css": "esbuild dist/bloom.css --minify --outfile=dist/bloom.min.css",
    "format": "elm-format src/elm/ --yes",
    "reactor": "elm reactor"
  }
}
